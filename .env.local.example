# ─── Teste local ─────────────────────────────────────────────────────
# Copie para .env.local e preencha as duas credenciais do Google.
#   cp .env.local.example .env.local

PUBLIC_URL=http://localhost:3000
LIVEKIT_URL=ws://localhost:7880

# Chaves fixas de desenvolvimento — batem com o docker-compose.local.yml.
# NUNCA use estas em producao.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_apenas_local_nao_use_em_producao

# ─── Google OAuth ────────────────────────────────────────────────────
# Mesmo Client ID que voce vai usar em producao. Basta adicionar uma
# segunda redirect URI autorizada no console do Google:
#   http://localhost:3000/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Sessao ──────────────────────────────────────────────────────────
# Qualquer coisa longa serve para teste local.
SESSION_SECRET=segredo_local_troque_isto_por_algo_aleatorio_1234567890

# ─── Allowlist ───────────────────────────────────────────────────────
ALLOWED_EMAILS=sartor.santos@gmail.com

PORT=3000
DB_PATH=/data/disc.db
