# ─── Domínio (Tailscale) ─────────────────────────────────────────────
# Preenchido pelo preparar-tailscale.ps1. É o nome da máquina na tailnet,
# tipo victor.tailXXXXXX.ts.net — o Tailscale emite um certificado real
# pra ele, que é o que faz o login do Google funcionar sem IP público.
DOMAIN=
PUBLIC_URL=https://
LIVEKIT_URL=wss://

# ─── LiveKit ─────────────────────────────────────────────────────────
# Gerado pelo preparar-tailscale.ps1.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Google OAuth ────────────────────────────────────────────────────
# console.cloud.google.com > Google Auth Platform > Clientes
# URI de redirecionamento autorizada: https://SEU_DOMINIO/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Sessão ──────────────────────────────────────────────────────────
# Gerado pelo preparar-tailscale.ps1.
SESSION_SECRET=

# ─── Allowlist ───────────────────────────────────────────────────────
# Só estes e-mails conseguem entrar. Separados por vírgula, sem espaço.
# Esta é a tranca que realmente vale — a lista de teste do Google é a
# segunda. Quem não está aqui não entra, mesmo com convite da tailnet.
ALLOWED_EMAILS=sartor.santos@gmail.com

# ─── Endereço na tailnet ─────────────────────────────────────────────
# Preenchido pelo preparar-tailscale.ps1. É o que o LiveKit anuncia como
# candidato ICE — sem isso ele anunciaria um IP que ninguém alcança.
TAILSCALE_IP=

# ─── Opcional ────────────────────────────────────────────────────────
PORT=3000
DB_PATH=/data/disc.db
