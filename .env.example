# ─── Domínio (DuckDNS) ───────────────────────────────────────────────
# Crie em https://www.duckdns.org e aponte para o IP fixo da VM
DOMAIN=seuservidor.duckdns.org
PUBLIC_URL=https://seuservidor.duckdns.org
LIVEKIT_URL=wss://seuservidor.duckdns.org

# ─── LiveKit ─────────────────────────────────────────────────────────
# Gere com: docker run --rm livekit/livekit-server generate-keys
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ─── Google OAuth ────────────────────────────────────────────────────
# console.cloud.google.com > APIs & Services > Credentials
# Redirect URI autorizada: https://seuservidor.duckdns.org/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Sessão ──────────────────────────────────────────────────────────
# Gere com: openssl rand -hex 32
SESSION_SECRET=

# ─── Allowlist ───────────────────────────────────────────────────────
# Só estes e-mails conseguem entrar. Separados por vírgula.
ALLOWED_EMAILS=sartor.santos@gmail.com

# ─── Opcional ────────────────────────────────────────────────────────
PORT=3000
DB_PATH=/data/disc.db

# ─── Só para hospedagem caseira (docker-compose.home.yml) ────────────
# Token da sua conta em duckdns.org — aparece no topo da página após login.
# Serve pro atualizador manter o domínio apontando pro IP certo.
DUCKDNS_SUBDOMAIN=seuservidor
DUCKDNS_TOKEN=

# ─── Só para o modo Tailscale (docker-compose.tailscale.yml) ─────────
# Preenchido automaticamente pelo preparar-tailscale.ps1
TAILSCALE_IP=
