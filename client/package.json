{
  "name": "disneia-client",
  "private": true,
  "version": "0.40.0",
  "description": "Disneia",
  "author": "Victor",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "livekit-client": "^2.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.disneia.app",
    "productName": "Disneia",
    "protocols": [
      {
        "name": "Disneia",
        "schemes": [
          "disc"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "electronLanguages": [
      "pt-BR",
      "en-US"
    ],
    "publish": {
      "provider": "generic",
      "url": "${env.VITE_SERVER_URL}/atualizacoes"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*",
      "node_modules/node-gyp-build/**/*"
    ],
    "win": {
      "target": "nsis",
      "extraResources": [
        {
          "from": "native/audio-win/build/Release/audio_win.node",
          "to": "audio_win.node"
        }
      ]
    },
    "linux": {
      "target": "AppImage",
      "category": "Network"
    }
  }
}
