# Segredos — NUNCA commitar
.env
*.env
.env.*
# ...menos os modelos, que são só estrutura sem valor nenhum dentro
!.env.example
!.env.*.example

# Notas locais — não fazem parte do que roda.
# Para versionar alguma delas depois, é só apagar a linha aqui.
#
# A barra inicial ancora na RAIZ. Sem ela, "DESIGN.md" casaria em qualquer
# profundidade e levaria junto design/DESIGN.md — que é documentação do
# projeto, não rascunho local.
/README.md
/DESIGN.md
/cores.md

# Rascunho de geração de imagem, não arte final - essa vive em design/
# junto do resto do material visual, mas sem entrar no histórico.
design/Gemini_Generated_Image_*.jpg

# Dados
data/
*.db
*.db-shm
*.db-wal

# Dependências e builds
node_modules/
dist/
dist-electron/
release/
# O build de Linux sai numa pasta à parte (ver publicar-linux.ps1). Precisa
# de linha própria: "release/" casa com o nome exato, não com o prefixo, e
# sem isto um AppImage de 100 MB fica esperando pra entrar num commit.
release-linux/
.vite/
# O componente nativo de áudio do Windows: a FONTE entra no histórico, o
# binário não. Ele é recompilado pelo publicar.ps1 antes de empacotar, e
# só serve pro ABI exato do Electron da vez — versionar o .obj e o .node
# só traria conflito binário em cada build.
client/native/*/build/

# Sistema
.DS_Store
Thumbs.db
*.log

# Certificados gerados pelo Tailscale — contêm chave privada
certs/

# Instaladores publicados pro auto-update. São artefatos de build (75 MB
# cada), não fonte — a pasta em si fica, o conteúdo não.
atualizacoes/*
!atualizacoes/.gitkeep
