# Caddy usando o certificado emitido pelo proprio Tailscale.
# Diferenca pro Caddyfile normal: nao pede certificado ao Let's Encrypt
# (o desafio HTTP-01 nao teria como chegar aqui atras do CGNAT).
{$DOMAIN} {
	tls /certs/tailscale.crt /certs/tailscale.key

	encode zstd gzip

	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle /twirp* {
		reverse_proxy livekit:7880
	}

	handle /whip* {
		reverse_proxy ingress:8080
	}

	# Feed de atualizacao do app (latest.yml + instalador).
	#
	# Sem login, e nao tem como ter: o app checa atualizacao antes de existir
	# sessao. Quem protege isto e a tailnet - de fora ninguem chega ate aqui.
	#
	# O file_server responde Range, que e o que o electron-updater usa pra
	# baixar so os blocos que mudaram em vez do instalador inteiro.
	handle_path /atualizacoes/* {
		root * /updates
		file_server
	}

	# Anexos do chat, com teto de corpo NO PROXY.
	#
	# O teto de verdade (200 MiB, com mensagem de erro em portugues) e do
	# Fastify, contado byte a byte enquanto o arquivo passa - ver o
	# /api/arquivos em server/src/arquivos.ts. Este aqui e o de fora: sem ele,
	# uma conexao que despeja bytes sem parar so morre depois que a aplicacao
	# contou 200 MiB, e o Caddy ja escreveu tudo isso no socket do container.
	#
	# 210 MiB, e nao 200: a folga garante que quem manda um arquivo pouco
	# acima do limite receba o 413 DA APLICACAO, que explica o que houve, em
	# vez do 413 seco do proxy. O proxy so entra no caso absurdo.
	#
	# O GET de download tambem cai aqui, e nao ha problema: requisicao sem
	# corpo nunca encosta no limite.
	handle /api/arquivos* {
		request_body {
			max_size 210MiB
		}
		reverse_proxy server:3000
	}

	handle {
		reverse_proxy server:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
