# Caddy usando o certificado emitido pelo proprio Tailscale.
# Diferenca pro Caddyfile normal: nao pede certificado ao Let's Encrypt
# (o desafio HTTP-01 nao teria como chegar aqui atras do CGNAT).
{$DOMAIN} {
	tls /certs/tailscale.crt /certs/tailscale.key

	encode zstd gzip

	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle /twirp* {
		reverse_proxy livekit:7880
	}

	handle /whip* {
		reverse_proxy ingress:8080
	}

	# Feed de atualizacao do app (latest.yml + instalador).
	#
	# Sem login, e nao tem como ter: o app checa atualizacao antes de existir
	# sessao. Quem protege isto e a tailnet - de fora ninguem chega ate aqui.
	#
	# O file_server responde Range, que e o que o electron-updater usa pra
	# baixar so os blocos que mudaram em vez do instalador inteiro.
	handle_path /atualizacoes/* {
		root * /updates
		file_server
	}

	handle {
		reverse_proxy server:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
